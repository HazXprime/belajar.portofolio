# ==============================================================================
# FULL-STACK CMS DEVELOPER PORTFOLIO - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# (Note: VITE_* variables are embedded into client bundle at build time.
#  NEVER place private secrets, tokens, or master passwords in VITE_* variables)
# ------------------------------------------------------------------------------
# In local development with Vite dev server proxy, keep empty or use ""
# In production on separate origin, set to backend domain: e.g. https://api.yourdomain.com
VITE_API_BASE_URL=

# Fallback email & site URL
VITE_CONTACT_EMAIL=adiputrayy1927@gmail.com
VITE_SITE_URL=https://your-portfolio-domain.vercel.app

# ------------------------------------------------------------------------------
# TURSO DATABASE / libSQL CONFIGURATION
# (Sign up at https://turso.tech, create database via 'turso db create portfolio-db')
# (Leave empty in local development to automatically use local file 'file:local.db')
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-database-auth-token-here

# ------------------------------------------------------------------------------
# CLOUDINARY MEDIA ASSET STORAGE
# (Obtain free credentials from Cloudinary Console: https://cloudinary.com)
# (If omitted in local dev, safe base64 fallback is used with zero crashes)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# INITIAL ADMIN BOOTSTRAP CREDENTIALS
# Used by 'npm run db:seed' or POST /api/auth/bootstrap
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="AdminPortfolio#2026!"
ADMIN_BOOTSTRAP_SECRET=super-secret-bootstrap-key-replace-in-production

# ------------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT & CORS CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=https://your-portfolio-domain.vercel.app
CORS_ALLOWED_ORIGINS=https://your-portfolio-domain.vercel.app
