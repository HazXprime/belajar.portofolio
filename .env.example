# Portfolio Configuration Environment Variables
# Note: VITE_ variables are embedded into frontend bundle at build time.
# NEVER put private API secrets, database credentials, or email service master keys here.

# Configured Contact Recipient Email
VITE_CONTACT_EMAIL=developer@example.com

# Site URL for canonical/OG metadata (set your production Vercel URL here)
VITE_SITE_URL=https://your-portfolio-domain.vercel.app
